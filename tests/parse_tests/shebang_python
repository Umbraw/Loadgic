#!/usr/bin/env python3
"""Shebang-based Python demo (no extension)."""

from dataclasses import dataclass

@dataclass
class User:
    name: str
    age: int

    def greet(self) -> str:
        return f"Hello {self.name}"

def add(a: int, b: int) -> int:
    return a + b

if __name__ == "__main__":
    print(add(2, 3))
